# Copy this file to .env and set your teammate's backend address.
# Leave it empty to keep using the demo data.
VITE_API_URL=

# Speech-to-text provider for the voice-input mic on the Describe page.
#   browser (default) - uses the device's built-in speech recognition (Chrome/Edge)
#   api                - calls the team's own speech service; implement
#                        apiRecognizer() in src/services/speech.js first
VITE_STT_PROVIDER=browser
